# CDC staging drill operator configuration (EXAMPLE — no credentials).
# Copy to a local, git-ignored file (e.g. cdc-drill.local.env) before a future drill.
# Never commit real values. Configuration audits list names only.

# --- Kit mode (defaults are safe) ---
# 1 = print commands only; 0 = execute (still subject to tier guards below)
CDC_DRILL_DRY_RUN=1

# Drill identity (filled by operator at execution time)
CDC_DRILL_ID=
CDC_DRILL_OPERATOR=
CDC_DRILL_ENVIRONMENT=staging
CDC_DRILL_STARTED_AT=

# --- Connection (names only — set values in git-ignored local file) ---
# Host/port/database/user/password/sslmode belong in operator secrets store.
CDC_DRILL_PG_HOST=
CDC_DRILL_PG_PORT=5432
CDC_DRILL_PG_DATABASE=
CDC_DRILL_PG_SSLMODE=verify-full

# Read-only preflight role (SELECT + catalog reads only)
CDC_DRILL_PG_USER_READONLY=

# Privileged replication role (REPLICATION + SELECT on allowlisted tables)
# Used only in privileged-manual tier; never embed password here.
CDC_DRILL_PG_USER_REPLICATION=

# --- Allowlist and slot naming ---
CDC_DRILL_SLOT_PREFIX=hudhud_bridge_staging_
CDC_DRILL_SLOT_NAME=
CDC_DRILL_PUBLICATION_NAME=hudhud_bridge_staging_pub
CDC_DRILL_PLUGIN=pgoutput

# Allowlisted append-only sources (ADR-0007 accepted observations)
CDC_DRILL_TABLE_SHIPMENT_EVENTS=public.shipment_events
CDC_DRILL_TABLE_AUDIT_LOGS=public.audit_logs

# --- WAL / stop thresholds (placeholders — tune with ops sign-off) ---
# Emergency stop if slot lag exceeds this many bytes
CDC_DRILL_WAL_LAG_STOP_BYTES=5368709120
# Warning threshold (bytes) — log and escalate, do not auto-stop
CDC_DRILL_WAL_LAG_WARN_BYTES=1073741824
# Minimum free disk on WAL volume (bytes) before continuing privileged steps
CDC_DRILL_MIN_WAL_VOLUME_FREE_BYTES=10737418240

# --- Bridge landing gate (ADR-0007 G5) ---
# Must remain 1 for production drill: slot feedback only after durable landing evidence
CDC_DRILL_REQUIRE_DURABLE_LANDING_BEFORE_FEEDBACK=1

# --- Destructive tier guard (default off) ---
CDC_DRILL_CONFIRM_DESTRUCTIVE=0

# --- Evidence output ---
CDC_DRILL_EVIDENCE_DIR=./evidence/cdc-drill-run
