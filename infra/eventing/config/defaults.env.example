# HUDHUD eventing foundation — local development defaults (names only; no secrets).
# Copy to defaults.env and adjust for disposable local validation.
# Production values require capacity evidence and ADR-0004 identity decisions.

# --- NATS server (single-node; replicas=1; not HA) ---
NATS_URL=nats://nats:4222
NATS_MONITOR_URL=http://nats:8222

# Optional host port bindings (leave empty for internal Compose networking only).
NATS_CLIENT_HOST_PORT=
NATS_MONITOR_HOST_PORT=

# JetStream file storage bounds (provisional — validate before production freeze).
JETSTREAM_STORE_DIR=/data/jetstream
JETSTREAM_MAX_FILE_STORE=2GB
JETSTREAM_MAX_MEMORY_STORE=256MB

# Per-stream retention (nanoseconds-compatible duration strings for bootstrap).
STREAM_MAX_AGE_OPS=7d
STREAM_MAX_AGE_FINANCE=30d
STREAM_MAX_AGE_WALLET=30d
STREAM_MAX_AGE_NOTIFICATION=3d
STREAM_MAX_AGE_AUDIT=365d
STREAM_MAX_AGE_DLQ=30d

# Message and consumer defaults (provisional — tune with capacity tests).
STREAM_MAX_MSG_SIZE=262144
STREAM_NUM_REPLICAS=1
CONSUMER_ACK_WAIT=30s
CONSUMER_MAX_DELIVER=5
CONSUMER_MAX_ACK_PENDING=100
CONSUMER_DUPLICATE_WINDOW=2m
CONSUMER_MAX_WAITING=512

# Local-dev credential profile (NOT production — replace per ADR-0004).
NATS_AUTH_ENABLED=false
