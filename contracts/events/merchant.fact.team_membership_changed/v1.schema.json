{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hudhud.platform/contracts/events/merchant.fact.team_membership_changed/v1.schema.json",
  "title": "merchant.fact.team_membership_changed v1",
  "description": "ADR-0011 M2 — Merchant-owned store team membership fact.",
  "allOf": [
    { "$ref": "../envelope/v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "event_type": { "const": "merchant.fact.team_membership_changed" },
        "event_version": { "const": 1 },
        "producer": { "const": "merchant" },
        "message_kind": { "const": "integration" },
        "aggregate_scope": { "const": "aggregate" },
        "aggregate_type": { "const": "merchant" },
        "aggregate_id": { "type": "string", "format": "uuid" },
        "aggregate_version": { "type": "integer", "minimum": 1 },
        "pii_present": {
          "const": false,
          "description": "The invited phone number never leaves Merchant on this event."
        },
        "schema_uri": {
          "type": "string",
          "const": "https://hudhud.platform/contracts/events/merchant.fact.team_membership_changed/v1.schema.json"
        },
        "payload": { "$ref": "v1.payload.schema.json" }
      },
      "required": [
        "event_type", "event_version", "producer", "message_kind",
        "aggregate_scope", "aggregate_type", "aggregate_id",
        "aggregate_version", "payload"
      ]
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": { "status": { "const": "ACTIVE" } },
            "required": ["status"]
          }
        },
        "required": ["payload"]
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "member_principal_id": { "type": "string", "format": "uuid" }
            },
            "required": ["member_principal_id"]
          }
        },
        "description": "An active membership must name the principal it belongs to — that principal is what downstream authorization resolves."
      }
    }
  ]
}
