{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hudhud.platform/contracts/events/pickup.fact.handover_completed/v1.schema.json",
  "title": "pickup.fact.handover_completed v1",
  "description": "ADR-0009 C11 — Pickup-owned custody-releasing hub handover fact. Contract registered; not production-enabled.",
  "allOf": [
    { "$ref": "../envelope/v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "event_type": { "const": "pickup.fact.handover_completed" },
        "event_version": { "const": 1 },
        "producer": { "const": "pickup" },
        "message_kind": { "const": "integration" },
        "aggregate_scope": { "const": "aggregate" },
        "aggregate_type": { "const": "pickup_task" },
        "aggregate_id": { "type": "string", "format": "uuid" },
        "aggregate_version": {
          "type": "integer",
          "minimum": 1,
          "description": "PickupTask-owned monotonic version. MUST NOT be a Shipment aggregate version."
        },
        "schema_uri": {
          "type": "string",
          "const": "https://hudhud.platform/contracts/events/pickup.fact.handover_completed/v1.schema.json"
        },
        "payload": { "$ref": "v1.payload.schema.json" }
      },
      "required": [
        "event_type",
        "event_version",
        "producer",
        "message_kind",
        "aggregate_scope",
        "aggregate_type",
        "aggregate_id",
        "aggregate_version",
        "payload"
      ]
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": { "outcome": { "const": "RECEIVED_WITH_DISCREPANCY" } },
            "required": ["outcome"]
          }
        },
        "required": ["payload"]
      },
      "then": {
        "required": ["media_refs"],
        "properties": {
          "media_refs": {
            "type": "array",
            "minItems": 1,
            "description": "Hub condition evidence remains envelope media_refs only. Required when the parcel is received in dispute."
          }
        }
      }
    }
  ]
}
