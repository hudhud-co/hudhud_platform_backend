{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hudhud.platform/contracts/events/finance.fact.payout_requested/v1.payload.schema.json",
  "title": "finance.fact.payout_requested v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payout_id",
    "merchant_id",
    "method",
    "amount_minor_units",
    "currency",
    "requested_at"
  ],
  "properties": {
    "payout_id": {
      "type": "string",
      "format": "uuid"
    },
    "merchant_id": {
      "type": "string",
      "format": "uuid"
    },
    "method": {
      "type": "string",
      "enum": [
        "BANK_TRANSFER",
        "MASTERCARD",
        "MONEY_EXCHANGE",
        "IN_PERSON_AT_HUB"
      ]
    },
    "amount_minor_units": {
      "type": "integer",
      "minimum": 1
    },
    "currency": {
      "type": "string",
      "enum": [
        "IQD"
      ]
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "has_destination": {
      "type": "boolean",
      "description": "Whether a destination was given. The destination itself is not published: an IBAN or a card reference is the merchant's, and the bus carries facts, not account numbers."
    }
  }
}
