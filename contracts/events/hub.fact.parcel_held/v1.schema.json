{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hudhud.platform/contracts/events/hub.fact.parcel_held/v1.schema.json",
  "title": "hub.fact.parcel_held v1",
  "description": "ADR-0011 H2 — Hub-owned fact that a parcel has been stopped inside the network.",
  "allOf": [
    { "$ref": "../envelope/v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "event_type": { "const": "hub.fact.parcel_held" },
        "event_version": { "const": 1 },
        "producer": { "const": "hub" },
        "message_kind": { "const": "integration" },
        "aggregate_scope": { "const": "aggregate" },
        "aggregate_type": { "const": "hub_parcel" },
        "aggregate_id": { "type": "string", "format": "uuid" },
        "aggregate_version": { "type": "integer", "minimum": 1 },
        "pii_present": { "const": false },
        "schema_uri": {
          "type": "string",
          "const": "https://hudhud.platform/contracts/events/hub.fact.parcel_held/v1.schema.json"
        },
        "payload": { "$ref": "v1.payload.schema.json" }
