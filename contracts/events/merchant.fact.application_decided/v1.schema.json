{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hudhud.platform/contracts/events/merchant.fact.application_decided/v1.schema.json",
  "title": "merchant.fact.application_decided v1",
  "description": "ADR-0011 M1 — Merchant-owned merchant-status decision fact.",
  "allOf": [
    { "$ref": "../envelope/v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "event_type": { "const": "merchant.fact.application_decided" },
        "event_version": { "const": 1 },
        "producer": { "const": "merchant" },
        "message_kind": { "const": "integration" },
        "aggregate_scope": { "const": "aggregate" },
        "aggregate_type": { "const": "merchant_application" },
        "aggregate_id": { "type": "string", "format": "uuid" },
        "aggregate_version": { "type": "integer", "minimum": 1 },
        "pii_present": {
          "const": false,
          "description": "The application's own answers never leave Merchant on this event."
        },
        "schema_uri": {
          "type": "string",
          "const": "https://hudhud.platform/contracts/events/merchant.fact.application_decided/v1.schema.json"
        },
        "payload": { "$ref": "v1.payload.schema.json" }
      },
      "required": [
        "event_type", "event_version", "producer", "message_kind",
        "aggregate_scope", "aggregate_type", "aggregate_id",
        "aggregate_version", "payload"
      ]
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": { "decision": { "const": "APPROVED" } },
            "required": ["decision"]
          }
        },
        "required": ["payload"]
      },
      "then": {
        "properties": {
          "payload": { "required": ["merchant_id", "merchant_code"] }
        },
        "description": "An approval that does not name the merchant it created is not actionable."
      }
    }
  ]
}
