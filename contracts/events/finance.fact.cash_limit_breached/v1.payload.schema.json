{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hudhud.platform/contracts/events/finance.fact.cash_limit_breached/v1.payload.schema.json",
  "title": "finance.fact.cash_limit_breached v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "driver_principal_id",
    "held_minor_units",
    "limit_minor_units",
    "currency",
    "utilisation_percent",
    "observed_at"
  ],
  "properties": {
    "driver_principal_id": {
      "type": "string",
      "format": "uuid"
    },
    "held_minor_units": {
      "type": "integer",
      "minimum": 0
    },
    "limit_minor_units": {
      "type": "integer",
      "minimum": 1
    },
    "currency": {
      "type": "string",
      "enum": [
        "IQD"
      ]
    },
    "utilisation_percent": {
      "type": "integer",
      "minimum": 0
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
