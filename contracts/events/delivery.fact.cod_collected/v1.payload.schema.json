{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hudhud.platform/contracts/events/delivery.fact.cod_collected/v1.payload.schema.json",
  "title": "delivery.fact.cod_collected v1 payload",
  "description": "ADR-0012 — the operational fact that money changed hands at the door. Finance owns the posting; Delivery states only what happened (ADR-0005 direction preserved: Delivery never writes the wallet). Amounts are exact minor units with an explicit currency, never a decimal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stop_id",
    "tracking_code",
    "method",
    "amount_minor_units",
    "currency",
    "collected_at",
    "collecting_driver_id",
    "enters_driver_cash_custody"
  ],
  "properties": {
    "stop_id": { "type": "string", "format": "uuid" },
    "tracking_code": { "type": "string", "pattern": "^SHP-\\d{8}-\\d{6}$" },
    "method": { "type": "string", "enum": ["CASH", "POS_CARD"] },
    "amount_minor_units": { "type": "integer", "minimum": 1 },
    "currency": { "type": "string", "enum": ["IQD"] },
    "pos_reference": {
      "type": ["string", "null"],
      "maxLength": 32,
      "description": "Present for a card payment unless a receipt photo was the proof instead."
    },
    "pos_receipt_captured": { "type": "boolean" },
    "collected_at": { "type": "string", "format": "date-time" },
    "collecting_driver_id": { "type": "string", "format": "uuid" },
    "enters_driver_cash_custody": {
      "type": "boolean",
      "description": "True only for cash. Driver App v8: 'Card payments go straight to HUDHUD — this amount is not added to your cash on hand.'"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "method": { "const": "POS_CARD" } }, "required": ["method"] },
      "then": {
        "properties": {
          "enters_driver_cash_custody": {
            "const": false,
            "description": "A card payment never enters driver custody — counting it would make a driver liable for money they never held."
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "CASH" } }, "required": ["method"] },
      "then": {
        "properties": { "enters_driver_cash_custody": { "const": true } }
      }
    },
    {
      "if": { "properties": { "method": { "const": "POS_CARD" } }, "required": ["method"] },
      "then": {
        "anyOf": [
          { "properties": { "pos_reference": { "type": "string", "minLength": 4 } },
            "required": ["pos_reference"] },
          { "properties": { "pos_receipt_captured": { "const": true } },
            "required": ["pos_receipt_captured"] }
        ],
        "description": "DRV-L14 — one proof is required before the parcel is handed over."
      }
    }
  ]
}
